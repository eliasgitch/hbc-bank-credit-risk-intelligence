table FactLoanSnapshot
	lineageTag: e3bf2223-30ae-40f2-a459-99faddaa179b

	/// BANKRISK | Gross Exposure. Aggregates respect the current report filter context.
	measure 'Gross Exposure' = VAR _month = MAX('DimDate'[DateKey]) RETURN CALCULATE(SUM('FactLoanSnapshot'[ExposureEUR]), 'DimDate'[DateKey] = _month)
		formatString: €#,##0;€-#,##0
		lineageTag: 8b26983a-3647-479f-9844-1fca17097287

	/// BANKRISK | Expected Credit Loss. Aggregates respect the current report filter context.
	measure 'Expected Credit Loss' = VAR _month = MAX('DimDate'[DateKey]) RETURN CALCULATE(SUM('FactLoanSnapshot'[ECL_EUR]), 'DimDate'[DateKey] = _month)
		formatString: €#,##0;€-#,##0
		lineageTag: 73e104e8-49f5-408b-8754-94d5981d3455

	/// BANKRISK | Active Loans. Aggregates respect the current report filter context.
	measure 'Active Loans' = VAR _month = MAX('DimDate'[DateKey]) RETURN CALCULATE(DISTINCTCOUNT('FactLoanSnapshot'[LoanKey]), 'DimDate'[DateKey] = _month)
		formatString: #,##0
		lineageTag: ad89233b-726d-412d-aaf1-4f1aba91688f

	/// BANKRISK | Non-performing Exposure. Aggregates respect the current report filter context.
	measure 'Non-performing Exposure' = CALCULATE([Gross Exposure], 'FactLoanSnapshot'[IsNPL] = 1)
		formatString: €#,##0;€-#,##0
		lineageTag: 7802cfc1-246b-4974-8543-93febe4a1e77

	/// BANKRISK | NPL Ratio. Aggregates respect the current report filter context.
	measure 'NPL Ratio' = DIVIDE([Non-performing Exposure], [Gross Exposure])
		formatString: 0.00%
		lineageTag: 066ee984-5faf-41d7-a0f4-9285c969aebc

	/// BANKRISK | Stage 1 Exposure. Aggregates respect the current report filter context.
	measure 'Stage 1 Exposure' = CALCULATE([Gross Exposure], 'FactLoanSnapshot'[Stage] = 1)
		formatString: €#,##0;€-#,##0
		lineageTag: a6fac143-8a5b-4d64-a408-f30fd53ade42

	/// BANKRISK | Stage 2 Exposure. Aggregates respect the current report filter context.
	measure 'Stage 2 Exposure' = CALCULATE([Gross Exposure], 'FactLoanSnapshot'[Stage] = 2)
		formatString: €#,##0;€-#,##0
		lineageTag: 2d3c690e-816e-4ae5-9192-d7b56c92de25

	/// BANKRISK | Stage 3 Exposure. Aggregates respect the current report filter context.
	measure 'Stage 3 Exposure' = CALCULATE([Gross Exposure], 'FactLoanSnapshot'[Stage] = 3)
		formatString: €#,##0;€-#,##0
		lineageTag: d7dae33e-0e30-485a-8521-8288dcab3f2c

	/// BANKRISK | Stage 2 + 3 Ratio. Aggregates respect the current report filter context.
	measure 'Stage 2 + 3 Ratio' = DIVIDE([Stage 2 Exposure] + [Stage 3 Exposure], [Gross Exposure])
		formatString: 0.00%
		lineageTag: 7439054d-3968-45f0-83f7-c7a399529c5e

	/// BANKRISK | DPD 30+ Exposure. Aggregates respect the current report filter context.
	measure 'DPD 30+ Exposure' = CALCULATE([Gross Exposure], 'FactLoanSnapshot'[DPD] >= 30)
		formatString: €#,##0;€-#,##0
		lineageTag: 2fa89aac-3085-4996-880e-8e4e0c388d86

	/// BANKRISK | DPD 30+ Ratio. Aggregates respect the current report filter context.
	measure 'DPD 30+ Ratio' = DIVIDE([DPD 30+ Exposure], [Gross Exposure])
		formatString: 0.00%
		lineageTag: 13b0ba25-14c6-4630-934f-ae7f08a02f2f

	/// BANKRISK | ECL Coverage. Aggregates respect the current report filter context.
	measure 'ECL Coverage' = DIVIDE([Expected Credit Loss], [Non-performing Exposure])
		formatString: 0.00%
		lineageTag: eea6c501-d5c2-4fd5-94c9-2f62ffe0668a

	/// BANKRISK | Weighted PD. Aggregates respect the current report filter context.
	measure 'Weighted PD' = VAR _month = MAX('DimDate'[DateKey]) RETURN DIVIDE(CALCULATE(SUMX('FactLoanSnapshot','FactLoanSnapshot'[ExposureEUR] * 'FactLoanSnapshot'[PD]), 'DimDate'[DateKey] = _month), [Gross Exposure])
		formatString: 0.00%
		lineageTag: 5501bf40-f6a0-4b2b-ba62-463df6477182

	/// BANKRISK | Weighted LGD. Aggregates respect the current report filter context.
	measure 'Weighted LGD' = VAR _month = MAX('DimDate'[DateKey]) RETURN DIVIDE(CALCULATE(SUMX('FactLoanSnapshot','FactLoanSnapshot'[ExposureEUR] * 'FactLoanSnapshot'[LGD]), 'DimDate'[DateKey] = _month), [Gross Exposure])
		formatString: 0.00%
		lineageTag: d8dcb77c-597d-41ae-ac49-8998151fea90

	/// BANKRISK | Interest Accrued. Aggregates respect the current report filter context.
	measure 'Interest Accrued' = VAR _month = MAX('DimDate'[DateKey]) RETURN CALCULATE(SUM('FactLoanSnapshot'[InterestEUR]), 'DimDate'[DateKey] = _month)
		formatString: €#,##0;€-#,##0
		lineageTag: 3ef7f9cc-266a-403d-bf61-86e07fbc8577

	/// BANKRISK | Annualised Yield. Aggregates respect the current report filter context.
	measure 'Annualised Yield' = DIVIDE([Interest Accrued] * 12, [Gross Exposure])
		formatString: 0.00%
		lineageTag: 178bd25d-b012-4ce3-a850-d7a7132f5c9a

	/// BANKRISK | Scheduled Collections. Aggregates respect the current report filter context.
	measure 'Scheduled Collections' = SUM('FactPayment'[ScheduledEUR])
		formatString: €#,##0;€-#,##0
		lineageTag: 1979a54f-e088-4ed1-8d6c-64daa02fd624

	/// BANKRISK | Actual Collections. Aggregates respect the current report filter context.
	measure 'Actual Collections' = SUM('FactPayment'[ReceivedEUR])
		formatString: €#,##0;€-#,##0
		lineageTag: 00af1310-2727-4882-b819-3879dd4c065e

	/// BANKRISK | Collection Efficiency. Aggregates respect the current report filter context.
	measure 'Collection Efficiency' = DIVIDE([Actual Collections], [Scheduled Collections])
		formatString: 0.00%
		lineageTag: d4762424-c338-4cdc-8311-975a5aaab47c

	/// BANKRISK | Amounts in Arrears. Aggregates respect the current report filter context.
	measure 'Amounts in Arrears' = SUM('FactPayment'[ArrearsEUR])
		formatString: €#,##0;€-#,##0
		lineageTag: 0999ef13-6ea9-4134-a49c-6e8e7cfafce0

	/// BANKRISK | Recoveries. Aggregates respect the current report filter context.
	measure Recoveries = SUM('FactRecovery'[RecoveryEUR])
		formatString: €#,##0;€-#,##0
		lineageTag: 76f8f869-f7d8-4c5f-94fc-044f92dcaefb

	/// BANKRISK | 30 to 60+ Roll Rate. Aggregates respect the current report filter context.
	measure '30 to 60+ Roll Rate' = DIVIDE(CALCULATE(SUM('FactTransition'[ExposureEUR]),'FactTransition'[FromBucket]=1,'FactTransition'[ToBucket]>=2),CALCULATE(SUM('FactTransition'[ExposureEUR]),'FactTransition'[FromBucket]=1))
		formatString: 0.00%
		lineageTag: e538fa09-70b9-4eb1-bdc7-a68b144fb528

	/// BANKRISK | 60 to 90+ Roll Rate. Aggregates respect the current report filter context.
	measure '60 to 90+ Roll Rate' = DIVIDE(CALCULATE(SUM('FactTransition'[ExposureEUR]),'FactTransition'[FromBucket]=2,'FactTransition'[ToBucket]=3),CALCULATE(SUM('FactTransition'[ExposureEUR]),'FactTransition'[FromBucket]=2))
		formatString: 0.00%
		lineageTag: 73399f94-c1df-4ebb-8bcb-c9c210e6dfce

	/// BANKRISK | Previous Month Exposure. Aggregates respect the current report filter context.
	measure 'Previous Month Exposure' = VAR Idx = MAX('DimDate'[MonthIndex]) RETURN CALCULATE([Gross Exposure], REMOVEFILTERS('DimDate'), 'DimDate'[MonthIndex] = Idx-1)
		formatString: €#,##0;€-#,##0
		lineageTag: 0f1492b6-41d5-4036-894f-02ea6eec166a

	/// BANKRISK | Exposure MoM. Aggregates respect the current report filter context.
	measure 'Exposure MoM' = DIVIDE([Gross Exposure]-[Previous Month Exposure],[Previous Month Exposure])
		formatString: 0.00%
		lineageTag: c7cf2826-9a40-4213-b390-d72c478f5ffa

	/// BANKRISK | Last 12M Average NPL. Aggregates respect the current report filter context.
	measure 'Last 12M Average NPL' = VAR Idx = MAX('DimDate'[MonthIndex]) RETURN AVERAGEX(FILTER(ALL('DimDate'),'DimDate'[MonthIndex]>Idx-12 && 'DimDate'[MonthIndex]<=Idx),CALCULATE([NPL Ratio]))
		formatString: 0.00%
		lineageTag: 54e4b487-e57a-4fcd-a755-65fe759baede

	/// BANKRISK | Stage 3 ECL. Aggregates respect the current report filter context.
	measure 'Stage 3 ECL' = CALCULATE([Expected Credit Loss],'FactLoanSnapshot'[Stage]=3)
		formatString: €#,##0;€-#,##0
		lineageTag: b248a7dd-a067-40a5-a140-18333c26db33

	/// BANKRISK | Scenario PD Multiplier. Aggregates respect the current report filter context.
	measure 'Scenario PD Multiplier' = SELECTEDVALUE('DimScenario'[PDMultiplier],1)
		formatString: 0.00
		lineageTag: 22e5c2ce-45bb-4293-8575-cb29addb8d38

	/// BANKRISK | Scenario LGD Multiplier. Aggregates respect the current report filter context.
	measure 'Scenario LGD Multiplier' = SELECTEDVALUE('DimScenario'[LGDMultiplier],1)
		formatString: 0.00
		lineageTag: 169f5d7e-15a5-441c-bfdf-c21483012f89

	/// BANKRISK | Scenario EAD Multiplier. Aggregates respect the current report filter context.
	measure 'Scenario EAD Multiplier' = SELECTEDVALUE('DimScenario'[EADMultiplier],1)
		formatString: 0.00
		lineageTag: 7fa6e76d-0e96-44c7-8576-f4a669f8df46

	/// BANKRISK | Simulated ECL. Aggregates respect the current report filter context.
	measure 'Simulated ECL' = ([Expected Credit Loss]-[Stage 3 ECL])*[Scenario PD Multiplier]*[Scenario LGD Multiplier]*[Scenario EAD Multiplier]+[Stage 3 ECL]*[Scenario LGD Multiplier]*[Scenario EAD Multiplier]
		formatString: €#,##0;€-#,##0
		lineageTag: dc226bfc-59e5-4509-8476-3425b457b10d

	/// BANKRISK | Scenario ECL Delta. Aggregates respect the current report filter context.
	measure 'Scenario ECL Delta' = [Simulated ECL]-[Expected Credit Loss]
		formatString: €#,##0;€-#,##0
		lineageTag: c13ebb1a-c024-4378-9dfa-726758e0e402

	/// BANKRISK | Scenario ECL Delta %. Aggregates respect the current report filter context.
	measure 'Scenario ECL Delta %' = DIVIDE([Scenario ECL Delta],[Expected Credit Loss])
		formatString: 0.00%
		lineageTag: e85a527d-9e45-4260-bb22-4904bb2e8710

	/// BANKRISK DataView bridge. RAW additive measure, respects Date/Product/Region/Grade and external report filters.
	measure 'BRIDGE Exposure EUR' = SUM('FactLoanSnapshot'[ExposureEUR])
		formatString: €#,##0;€-#,##0
