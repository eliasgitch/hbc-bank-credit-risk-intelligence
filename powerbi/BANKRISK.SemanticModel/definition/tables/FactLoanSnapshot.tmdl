	/// BANKRISK DataView bridge. RAW additive measure, respects Date/Product/Region/Grade and external report filters.
	measure 'BRIDGE Scheduled EUR' = VAR LoansInSlice = VALUES('FactLoanSnapshot'[LoanKey]) RETURN CALCULATE(SUM('FactPayment'[ScheduledEUR]), TREATAS(LoansInSlice, 'FactPayment'[LoanKey]))
		formatString: €#,##0;€-#,##0
		lineageTag: 63bac909-c613-4475-878b-b0da7f0cd6d4

