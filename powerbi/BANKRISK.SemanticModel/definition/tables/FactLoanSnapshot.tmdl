	measure 'Exposure 12M Delta %' = VAR _idx = MAX('DimDate'[MonthIndex]) VAR _base = CALCULATE([Gross Exposure],FILTER(ALL('DimDate'),'DimDate'[MonthIndex] = _idx - 11)) RETURN DIVIDE([Gross Exposure] - _base, _base)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 8989ab42-1f52-402f-a264-77ccd1e4fd73

	measure 'NPL 12M Delta pp' = VAR _idx = MAX('DimDate'[MonthIndex]) VAR _base = CALCULATE([NPL Ratio],FILTER(ALL('DimDate'),'DimDate'[MonthIndex] = _idx - 11)) RETURN ([NPL Ratio] - _base) * 100
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
