	measure 'BRIDGE DPD 30+ EUR' = CALCULATE(SUM('FactLoanSnapshot'[ExposureEUR]), 'FactLoanSnapshot'[DPD] >= 30)
		formatString: €#,##0;€-#,##0
		lineageTag: 58d3aa2c-f319-4bb1-ae05-f088f099542a

