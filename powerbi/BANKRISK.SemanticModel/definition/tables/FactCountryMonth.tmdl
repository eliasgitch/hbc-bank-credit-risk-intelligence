		lineageTag: 726df40f-3068-4b3e-8a41-b94530207de2

	/// HBC Bank synthetic international market allocation
	measure 'Global Stage 2 + 3 Ratio' = DIVIDE([Global Stage 2 EUR]+[Global Stage 3 EUR],[Global Exposure EUR])
		formatString: 0.00%
		lineageTag: e4546f1c-da92-4f68-aace-05b158bd7819

	/// HBC Bank synthetic international market allocation
	measure 'Global ECL Coverage' = DIVIDE([Global ECL EUR],[Global NPL EUR])
